{
  "name": "A run moves the due date by the interval, a failure by the retry days",
  "steps": [
    { "call": "job.create", "params": { "title": "Energy invoice", "entry_url": "https://portal.example.org/energy", "interval_weeks": 4, "retry_days": 3, "next_due": "$today-2", "username": "ada", "password": "correct horse" },
      "expect": { "title": "Energy invoice", "next_due": "$today-2", "urgency_days": -2, "username": "ada", "password": "correct horse", "last_run": null },
      "save": { "id": "/job_id", "guid": "/guid" } },
    { "call": "job.create", "params": { "title": "Water", "entry_url": "https://portal.example.org/water", "interval_weeks": 12 }, "expect": { "next_due": "$today", "retry_days": 2 } },
    { "call": "job.list", "params": {}, "expect": { "today": "$today", "jobs": [ { "guid": "$guid" }, { "title": "Water" } ] } },
    { "call": "job.complete", "params": { "job_id": "$id", "outcome": "failed", "note": "Portal down", "expected_next_due": "$today-2" }, "expect": { "outcome": "failed", "due_before": "$today-2", "next_due": "$today+3" } },
    { "call": "job.complete", "params": { "job_id": "$id", "outcome": "succeeded", "expected_next_due": "$today-2" }, "error": "job_changed" },
    { "call": "job.complete", "params": { "job_id": "$id", "outcome": "succeeded", "note": "filed", "expected_next_due": "$today+3" }, "expect": { "next_due": "$today+28" } },
    { "call": "job.get", "params": { "job_id": "$id" }, "expect": { "next_due": "$today+28", "urgency_days": 28, "last_run": { "outcome": "succeeded", "note": "filed", "finished_at": "$any", "by": "$any" } } },
    { "call": "job.history", "params": { "job_id": "$id" }, "expect": { "runs": [ { "outcome": "succeeded", "note": "filed" }, { "outcome": "failed", "note": "Portal down", "due_after": "$today+3" } ] } },
    { "call": "job.list", "params": {}, "expect": { "jobs": [ { "title": "Water" }, { "guid": "$guid" } ] } }
  ]
}
