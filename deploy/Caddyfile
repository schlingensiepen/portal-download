# Caddy in the container: TLS for $SITE with the certificate in the volume (created by
# start.sh, or put there by the operator), and the service behind it on the loopback interface.
{
	admin off
	persist_config off
	auto_https disable_redirects
	skip_install_trust
	# Without it Caddy waits for open connections forever when the container stops.
	grace_period 3s
	# TCP only: the one-line start publishes 443/tcp, not UDP for HTTP/3.
	servers {
		protocols h1 h2
	}
	# Warnings and errors only, so that the ready block of start.sh stands out in the log.
	log default {
		level WARN
	}
}

{$SITE} {
	tls /data/tls/cert.pem /data/tls/key.pem
	reverse_proxy 127.0.0.1:8080
}

# Every other name, and a handshake without one (a bare IP address), gets the certificate of
# $SITE, so that the browser warns about the name instead of ending the handshake with an
# internal error, and leads to the address of $SITE.
https:// {
	tls /data/tls/cert.pem /data/tls/key.pem
	redir https://{$SITE}{uri}
}
